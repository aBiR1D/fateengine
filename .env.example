# Fate Engine Configuration
# Copy to .env and fill in your keys

# LLM Provider — "anthropic" or "openai"
FATEENGINE_PROVIDER=anthropic

# API Keys (provide one matching your provider)
FATEENGINE_ANTHROPIC_API_KEY=sk-ant-...
FATEENGINE_OPENAI_API_KEY=sk-...

# Model to use
FATEENGINE_MODEL=claude-sonnet-4-20250514

# Generation settings
FATEENGINE_TEMPERATURE=0.8
FATEENGINE_MAX_TOKENS=4096

# API server
FATEENGINE_API_HOST=0.0.0.0
FATEENGINE_API_PORT=8420
